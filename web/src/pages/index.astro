---
import Layout from '../layouts/Layout.astro';
import Downloader from '../components/Downloader.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
---

<Layout
  title="YouPiper — Free YouTube Video Downloader"
  description="Download YouTube videos and audio in 1080p, 720p, 480p, and 360p MP4 or MP3. Works straight from your browser, and even faster with YouPiper Helper."
>
  <div class="homepage-wrapper">
    <!-- Hero & Downloader (Above the fold) -->
    <section class="downloader-section">
      <Downloader />
    </section>

    <!-- Top Advertisement Placeholder -->
    <AdPlaceholder slotLocation="top-banner" />

    <!-- How It Works Section -->
    <section class="content-section">
      <h2 class="section-heading">How YouPiper Works</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3 class="step-title">Paste Video URL</h3>
          <p class="step-desc">Copy any YouTube link and paste it into the downloader field above.</p>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h3 class="step-title">Analyze Formats</h3>
          <p class="step-desc">Click analyze to see every quality the video offers — 1080p, 720p, 480p, 360p, and MP3.</p>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h3 class="step-title">Pick Your Quality</h3>
          <p class="step-desc">Choose a video resolution, or grab audio only as an MP3.</p>
        </div>
        <div class="step-card">
          <div class="step-number">4</div>
          <h3 class="step-title">Download</h3>
          <p class="step-desc">Your file arrives through your browser. With YouPiper Helper installed, it lands in your Downloads folder instead — no waiting in line.</p>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="content-section light-bg">
      <h2 class="section-heading">Why Choose YouPiper?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🔓</div>
          <h3 class="feature-title">No Account, No Limits</h3>
          <p class="feature-desc">
            No sign-up, no email, no install required. Paste a link and download — nothing is kept after your file is delivered.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3 class="feature-title">Faster With Helper</h3>
          <p class="feature-desc">
            Install YouPiper Helper once and downloads run at your own connection speed, straight to your computer, with no server queue.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎬</div>
          <h3 class="feature-title">Real MP4 & MP3 Files</h3>
          <p class="feature-desc">
            Video comes out as a genuine MP4 up to 1080p with audio properly merged in. Audio-only downloads come out as MP3.
          </p>
        </div>
      </div>
    </section>

    <!-- Mid Content Advertisement Placeholder -->
    <AdPlaceholder slotLocation="mid-banner" />

    <!-- FAQ Section -->
    <section class="content-section">
      <h2 class="section-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-question">How does YouPiper work?</summary>
          <div class="faq-answer">
            Paste a YouTube link and press Analyze. YouPiper reads the video's available qualities and shows them as a list. Pick one, press Download, and YouPiper fetches the video, merges the audio into it, and hands you the finished file.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Do I need to install anything?</summary>
          <div class="faq-answer">
            No. YouPiper works entirely in your browser with nothing installed — that is the default for everyone. YouPiper Helper is an optional add-on that makes downloads faster, but you never need it to download a video.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What is YouPiper Helper?</summary>
          <div class="faq-answer">
            YouPiper Helper is a small free companion you install once on your computer. When it's running, this site hands your download to it instead of to our servers, so the video downloads at your own connection speed and saves straight to your Downloads folder — no queue, no waiting behind other people. <a href="/helper">Learn more about YouPiper Helper</a>.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Where do my downloads go?</summary>
          <div class="faq-answer">
            Without the Helper, the file is delivered through your browser and lands wherever your browser normally saves downloads. With YouPiper Helper installed, it's saved straight into your Downloads folder automatically.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">What qualities and formats are available?</summary>
          <div class="faq-answer">
            Video is available in 1080p, 720p, 480p, and 360p as MP4 files, depending on what the original upload offers. Audio-only downloads are delivered as MP3.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">Does YouPiper Helper work on macOS and Windows?</summary>
          <div class="faq-answer">
            Yes — YouPiper Helper runs on macOS, Windows, and Linux. The website itself works on any modern browser, including phones and tablets.
          </div>
        </details>
      </div>
    </section>

    <!-- Legal & Responsible Use Notice -->
    <section class="legal-notice-box">
      <p>
        <strong>Legal & Responsible Use Notice:</strong> YouPiper is designed for personal archiving and educational purposes. Users are expected to respect copyright law and only download media they own or have explicit permission from the copyright holder to download.
      </p>
    </section>
  </div>
</Layout>

<style>
  .homepage-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .downloader-section {
    padding: 32px 0 16px;
  }

  .content-section {
    margin: 64px 0;
  }

  .content-section.light-bg {
    background-color: var(--color-surface-soft);
    padding: 48px 32px;
    border-radius: var(--rounded-lg);
    border: 1px solid var(--color-hairline-soft);
  }

  .section-heading {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-ink);
    text-align: center;
    margin-bottom: 40px;
    letter-spacing: -0.4px;
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }

  .step-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .step-number {
    width: 36px;
    height: 36px;
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .step-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .step-desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .feature-card {
    background-color: var(--color-canvas);
    padding: 32px;
    border-radius: var(--rounded-md);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-card);
  }

  .feature-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .feature-desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* FAQ List */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 840px;
    margin: 0 auto;
  }

  .faq-item {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: 20px 24px;
    box-shadow: var(--shadow-card);
  }

  .faq-question {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    outline: none;
    cursor: pointer;
  }

  .faq-answer {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .faq-answer a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Legal Notice Box */
  .legal-notice-box {
    margin-top: 48px;
    padding: 20px 24px;
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
    text-align: center;
  }
</style>
