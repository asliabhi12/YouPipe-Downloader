---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import AgentStatus from '../components/AgentStatus.astro';

const helperVersion = '0.1.0';

const winFilename = 'YouPiper-Helper-0.1.0-amd64.exe';

const publicDownloadsDir = path.join(process.cwd(), 'public', 'downloads');
const winFilePath = path.join(publicDownloadsDir, winFilename);

const winExists = fs.existsSync(winFilePath);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://youpiper.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Help & Guide",
          "item": "https://youpiper.com/helper"
        }
      ]
    }
  ]
};
---

<Layout
  title="YouPiper Help – YouTube Downloader Guide & Help"
  description="Need help using YouPiper? Read our complete YouTube downloader guide, learn how YouPiper Helper works, troubleshoot issues, and find answers to common questions."
  canonicalUrl="https://youpiper.com/helper"
  ogTitle="YouPiper Help – YouTube Downloader Guide & Help"
  ogDescription="Need help using YouPiper? Read our complete YouTube downloader guide, learn how YouPiper Helper works, troubleshoot issues, and find answers to common questions."
  twitterTitle="YouPiper Help – YouTube Downloader Guide & Help"
  twitterDescription="Need help using YouPiper? Read our complete YouTube downloader guide, learn how YouPiper Helper works, troubleshoot issues, and find answers to common questions."
  jsonLd={breadcrumbJsonLd}
>
  <div class="helper-page-wrapper">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page"><span>Help & Guide</span></li>
      </ol>
    </nav>

    <!-- Hero Section -->
    <section class="helper-hero">
      <div class="badge-pill">⚡ Local Download Companion & User Guide</div>
      <h1 class="hero-title">YouPiper Help & Downloader Guide</h1>
      <p class="hero-subtitle">Learn how to use YouPiper, troubleshoot downloads, and set up YouPiper Helper.</p>
    </section>

    <!-- Status & Control Section -->
    <div class="helper-control-bar">
      <AgentStatus />
    </div>

    <!-- Key Benefits Section -->
    <section class="benefits-grid">
      <div class="benefit-card">
        <div class="benefit-icon">⚡</div>
        <h3 class="benefit-title">Faster downloads</h3>
        <p class="benefit-desc">
          Downloads video and audio directly to your computer at maximum network speed.
        </p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🚀</div>
        <h3 class="benefit-title">No server queue</h3>
        <p class="benefit-desc">
          Your download doesn't wait for other users or public cloud bandwidth caps.
        </p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🔒</div>
        <h3 class="benefit-title">100% Private</h3>
        <p class="benefit-desc">
          All media streams flow directly from YouTube to your local disk.
        </p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">✨</div>
        <h3 class="benefit-title">Simple</h3>
        <p class="benefit-desc">
          Install once and YouPiper handles the rest automatically whenever you visit the site.
        </p>
      </div>
    </section>

    <!-- Installation Downloads Section -->
    <section class="download-box" id="download-helper-section">
      <div class="version-badge">Version {helperVersion}</div>
      <h2 class="box-title">Get YouPiper Helper</h2>
      <p class="box-desc" id="os-detected-desc">
        Download the official desktop companion app for direct, unthrottled downloads saved straight to your computer.
      </p>

      <div class="installer-buttons" id="installer-buttons-grid">
        <div class="installer-card" data-platform="windows">
          <div class="card-header">
            <span class="os-name">Windows</span>
            <span class="detected-badge" hidden>Detected</span>
          </div>
          <div class="installer-meta">
            <span class="file-format">EXE • 64-bit</span>
            <span class="file-size">6.2 MB</span>
          </div>
          {winExists ? (
            <a
              href={`/downloads/${winFilename}`}
              download={winFilename}
              class="btn-installer"
              aria-label={`Download YouPiper Helper v${helperVersion} for Windows (64-bit EXE, 6.2 MB)`}
            >
              Download for Windows
            </a>
          ) : (
            <span class="btn-installer is-unavailable" aria-disabled="true">
              Windows installer unavailable
            </span>
          )}
          <span class="build-note">Windows 10 or later</span>
        </div>

        <div class="installer-card" data-platform="macos">
          <div class="card-header">
            <span class="os-name">macOS</span>
            <span class="detected-badge" hidden>Detected</span>
          </div>
          <span
            class="btn-installer is-pending"
            aria-disabled="true"
            aria-label="macOS version coming soon"
          >
            Coming soon
          </span>
          <span class="build-note">macOS 12 or later</span>
        </div>
      </div>

      <p class="mobile-note" id="mobile-installer-note" hidden>
        ℹ️ YouPiper Helper is designed for Windows and macOS desktop computers. Downloads work directly in your mobile browser without any helper app.
      </p>

      <p class="fallback-note">
        <a href="/">Download a video now</a> — no Helper required.
      </p>
    </section>

    <script>
      function initOsDetection() {
        if (typeof window === 'undefined' || typeof navigator === 'undefined') return;

        const ua = navigator.userAgent || '';
        const platform = (navigator as any).userAgentData?.platform || navigator.platform || '';

        const isMac = /mac/i.test(platform) || /macintosh|mac os x/i.test(ua);
        const isWin = /win/i.test(platform) || /windows|win32|win64/i.test(ua);
        const isMobile = /iphone|ipad|ipod|android/i.test(ua);

        const winCard = document.querySelector<HTMLElement>('[data-platform="windows"]');
        const macCard = document.querySelector<HTMLElement>('[data-platform="macos"]');
        const mobileNote = document.getElementById('mobile-installer-note');
        const descText = document.getElementById('os-detected-desc');

        if (isMobile) {
          if (mobileNote) mobileNote.hidden = false;
          return;
        }

        if (isWin && winCard) {
          winCard.classList.add('is-detected');
          const badge = winCard.querySelector<HTMLElement>('.detected-badge');
          if (badge) badge.hidden = false;
          if (descText) descText.textContent = 'Detected Windows — recommended desktop installer below:';
        } else if (isMac && macCard) {
          macCard.classList.add('is-detected');
          const badge = macCard.querySelector<HTMLElement>('.detected-badge');
          if (badge) badge.hidden = false;
          if (descText) descText.textContent = 'Detected macOS — desktop helper for macOS coming soon. Downloads work in browser.';
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOsDetection);
      } else {
        initOsDetection();
      }
    </script>

    <!-- Detailed Help & Guide Content -->
    <article class="guide-article">
      <h2>How to Use YouPiper</h2>
      <p>
        Using YouPiper is designed to be as simple as possible. Follow these steps to analyze and save eligible media:
      </p>
      <ol class="guide-steps">
        <li><strong>Copy Video Link:</strong> Open YouTube in your web browser or app, locate the video you are authorized to download, and copy its full address (e.g. <code>https://www.youtube.com/watch?v=...</code>).</li>
        <li><strong>Paste URL:</strong> Navigate to the <a href="/">YouPiper homepage</a>, <a href="/youtube-video-downloader">YouTube Video Downloader</a>, <a href="/youtube-mp4">YouTube to MP4</a>, or <a href="/youtube-mp3">YouTube to MP3</a> page.</li>
        <li><strong>Analyze Video:</strong> Paste the URL into the input field and click <strong>Analyze video</strong>. YouPiper will inspect the link and detect available resolutions.</li>
        <li><strong>Select Format & Download:</strong> Pick your preferred MP4 resolution (1080p, 720p, 480p, 360p) or MP3 audio option and click <strong>Download</strong>.</li>
      </ol>

      <h2>Troubleshooting Common Download Issues</h2>
      <p>
        If your download fails or does not start, check the following common causes:
      </p>
      <ul>
        <li><strong>Invalid or Unsupported URL:</strong> Ensure the link is a valid public YouTube URL. Links to private videos, unlisted videos without access permissions, or non-YouTube platforms cannot be processed.</li>
        <li><strong>Private or Country-Restricted Videos:</strong> Videos requiring login, age verification, or region locks cannot be fetched by web downloaders.</li>
        <li><strong>Network Connection Interruptions:</strong> If downloading stops mid-way, refresh the page and try again. Using <a href="/helper">YouPiper Helper</a> helps prevent network timeouts by saving directly to your computer.</li>
        <li><strong>Mobile Browser Restrictions:</strong> On iOS (iPhone/iPad), ensure you are using Safari so downloads save directly to your Files app. On Android, check that Chrome has permission to save files to your Downloads folder.</li>
      </ul>

      <h2>What is YouPiper Helper?</h2>
      <p>
        YouPiper Helper is a lightweight desktop companion app. When installed on your computer, YouPiper detects it automatically. Instead of routing media through cloud servers, the site delegates download processing directly to your local machine, giving you unthrottled network speed and instant file saving to your Downloads folder.
      </p>

      <h2 id="faq">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question"><h3>Do I need to install YouPiper Helper to use the site?</h3></summary>
          <div class="faq-answer">
            No. YouPiper works 100% in your browser out-of-the-box. YouPiper Helper is completely optional and only needed if you want direct, unthrottled local downloads.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question"><h3>Why does 1080p video take a few extra seconds to process?</h3></summary>
          <div class="faq-answer">
            YouTube separates 1080p video and audio into two distinct streams. YouPiper fetches both streams and merges them into a clean MP4 file before delivering it to your browser.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question"><h3>Are my downloads logged or stored on YouPiper servers?</h3></summary>
          <div class="faq-answer">
            No. YouPiper respects user privacy. Media files are delivered directly to your device and temporary processing files are purged immediately.
          </div>
        </details>
      </div>

      <section class="legal-notice-box">
        <p>
          <strong>Responsible Use Notice:</strong> Only download content when you have the necessary rights or permission to do so, or when downloading is otherwise permitted by the applicable service and law. YouPiper is intended for personal archiving and educational use.
        </p>
      </section>
    </article>

    <!-- Back link -->
    <div class="back-footer">
      <a href="/" class="back-link">← Back to Downloader</a>
    </div>
  </div>
</Layout>

<style>
  .helper-page-wrapper {
    max-width: 840px;
    margin: 0 auto;
    padding: 24px 24px 60px;
  }

  .breadcrumb-nav {
    margin-bottom: 24px;
    font-size: 14px;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-muted);
  }

  .breadcrumb-item a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb-item + .breadcrumb-item::before {
    content: "/";
    margin-right: 8px;
    color: var(--color-hairline);
  }

  .breadcrumb-item.active span {
    color: var(--color-ink);
    font-weight: 600;
  }

  .helper-hero {
    text-align: center;
    margin-bottom: 24px;
  }

  .helper-control-bar {
    max-width: 500px;
    margin: 0 auto 48px auto;
  }

  .badge-pill {
    display: inline-block;
    padding: 6px 14px;
    background-color: #e6f4ff;
    color: #0958d9;
    font-size: 13px;
    font-weight: 700;
    border-radius: var(--rounded-full);
    margin-bottom: 16px;
  }

  .hero-title {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.5px;
    margin-bottom: 12px;
  }

  .hero-subtitle {
    font-size: 18px;
    color: var(--color-muted);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
    margin-bottom: 48px;
  }

  .benefit-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: 24px;
    box-shadow: var(--shadow-card);
  }

  .benefit-icon {
    font-size: 28px;
    margin-bottom: 12px;
  }

  .benefit-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .benefit-desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .version-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-muted);
    background-color: var(--color-surface-strong);
    padding: 4px 12px;
    border-radius: var(--rounded-full);
    margin-bottom: 12px;
  }

  .download-box {
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-lg);
    padding: 40px 32px;
    text-align: center;
    margin-bottom: 48px;
  }

  .box-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .box-desc {
    font-size: 15px;
    color: var(--color-muted);
    margin-bottom: 32px;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .installer-buttons {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .installer-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    background: var(--color-canvas);
    padding: 24px 20px;
    border-radius: var(--rounded-md);
    border: 1px solid var(--color-hairline);
    min-width: 260px;
    max-width: 320px;
    flex: 1 1 260px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: var(--shadow-card);
    box-sizing: border-box;
  }

  .installer-card.is-detected {
    border-color: var(--color-primary);
    box-shadow: 0 4px 16px rgba(255, 56, 92, 0.15);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .os-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .detected-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    padding: 2px 8px;
    border-radius: 10px;
  }

  .installer-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--color-muted);
    font-weight: 500;
  }

  .btn-installer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 600;
    border-radius: var(--rounded-sm);
    text-decoration: none;
    font-size: 15px;
    width: 100%;
    transition: background-color 0.2s ease;
    box-sizing: border-box;
  }

  .btn-installer:hover {
    background-color: var(--color-primary-active);
  }

  .btn-installer:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .btn-installer.is-pending,
  .btn-installer.is-pending:hover,
  .btn-installer.is-unavailable,
  .btn-installer.is-unavailable:hover {
    background-color: var(--color-surface-strong);
    color: var(--color-muted);
    cursor: not-allowed;
    border: 1px solid var(--color-hairline);
    opacity: 0.75;
    box-shadow: none;
  }

  .build-note {
    font-size: 12px;
    color: var(--color-muted);
  }

  .mobile-note {
    margin-top: 24px;
    padding: 12px 16px;
    background-color: #fffbe6;
    border: 1px solid #ffe58f;
    border-radius: var(--rounded-sm);
    font-size: 13px;
    color: #873800;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
    line-height: 1.5;
  }

  .fallback-note {
    margin-top: 28px;
    font-size: 15px;
    color: var(--color-muted);
  }

  .fallback-note a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Guide Article Styling */
  .guide-article {
    margin: 48px 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body);
  }

  .guide-article h2 {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 36px;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }

  .guide-article p {
    margin-bottom: 16px;
  }

  .guide-article code {
    background-color: var(--color-surface-soft);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--color-ink);
  }

  .guide-steps, .guide-article ul {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .guide-steps li, .guide-article li {
    margin-bottom: 10px;
  }

  .guide-article a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guide-article a:hover {
    color: var(--color-primary-active);
  }

  /* FAQ Styling */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0 36px;
  }

  .faq-item {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: 20px 24px;
    box-shadow: var(--shadow-card);
  }

  .faq-question {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    outline: none;
    cursor: pointer;
  }

  .faq-question h3 {
    display: inline;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .faq-answer {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .legal-notice-box {
    margin-top: 40px;
    padding: 20px 24px;
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-sm);
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.6;
    text-align: center;
  }

  .back-footer {
    text-align: center;
    margin-top: 40px;
  }

  .back-link {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
