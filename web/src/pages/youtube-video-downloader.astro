---
import Layout from '../layouts/Layout.astro';
import Downloader from '../components/Downloader.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
---

<Layout
  title="Download YouTube Videos HD 1080p, 720p — YouPiper"
  description="High-definition YouTube video downloader. Save 1080p, 720p, 480p, and 360p MP4 videos free, with no sign-up and no software required."
>
  <div class="page-wrapper">
    <section class="downloader-section">
      <Downloader />
    </section>

    <AdPlaceholder slotLocation="seo-top" />

    <article class="seo-article">
      <h1>YouTube Video Downloader HD (1080p & 720p)</h1>
      <p>
        YouPiper downloads YouTube videos in full high definition — no account, no software, no waiting. Paste a link, pick a quality, and get a real MP4 file with the audio already merged in. Install the free YouPiper Helper and downloads run at your own connection speed instead of ours.
      </p>

      <h2>Key Benefits of HD Video Downloads</h2>
      <ul>
        <li><strong>True 1080p Full HD:</strong> Get the highest resolution the original upload actually offers, not an upscaled copy.</li>
        <li><strong>Audio Already Merged:</strong> YouTube stores high-resolution video and audio separately. YouPiper combines them for you, so the file just plays.</li>
        <li><strong>Genuine MP4 Files:</strong> Every video download is a real MP4 container — not a renamed file that breaks in your player.</li>
      </ul>

      <h2>Supported Video Formats & Quality Levels</h2>
      <p>
        Depending on the original upload quality, YouPiper offers 1080p, 720p, 480p, and 360p MP4 video, plus standalone MP3 audio.
      </p>

      <AdPlaceholder slotLocation="seo-mid" />

      <h2>How to Download HD Videos</h2>
      <ol>
        <li>Copy the link of the video you wish to download.</li>
        <li>Paste the URL into the YouPiper search box above and click <strong>Analyze</strong>.</li>
        <li>Select 1080p or your preferred quality.</li>
        <li>Click <strong>Download</strong> and save your file.</li>
      </ol>
    </article>
  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .seo-article {
    max-width: 800px;
    margin: 48px auto;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body);
  }

  .seo-article h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .seo-article h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .seo-article p {
    margin-bottom: 16px;
  }

  .seo-article ul, .seo-article ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .seo-article li {
    margin-bottom: 8px;
  }
</style>
