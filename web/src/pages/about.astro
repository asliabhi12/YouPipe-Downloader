---
import Layout from '../layouts/Layout.astro';

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://youpiper.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "About",
          "item": "https://youpiper.com/about"
        }
      ]
    }
  ]
};
---

<Layout
  title="About YouPiper – YouTube Video Downloader"
  description="Learn about YouPiper, our mission to provide a fast, clean, free browser-based video downloader, and how our optional helper app works."
  canonicalUrl="https://youpiper.com/about"
  ogTitle="About YouPiper – YouTube Video Downloader"
  ogDescription="Learn about YouPiper, our mission to provide a fast, clean, free browser-based video downloader, and how our optional helper app works."
  twitterTitle="About YouPiper – YouTube Video Downloader"
  twitterDescription="Learn about YouPiper, our mission to provide a fast, clean, free browser-based video downloader, and how our optional helper app works."
  jsonLd={breadcrumbJsonLd}
>
  <div class="page-wrapper">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page"><span>About</span></li>
      </ol>
    </nav>

    <article class="about-article">
      <h1>About YouPiper</h1>
      <p class="lead-text">
        YouPiper is built to make online media downloading simple, fast, and accessible across all devices. We eliminate unnecessary steps, deceptive download buttons, and account paywalls.
      </p>

      <h2>Our Core Mission</h2>
      <p>
        Finding a clean web tool to save video or audio content shouldn't involve navigating pop-ups or installing unwanted browser extensions. YouPiper was created to deliver a streamlined browser-first tool where users can analyze video links and download genuine MP4 or MP3 files immediately.
      </p>

      <h2>What Makes YouPiper Different</h2>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">⚡</div>
          <h3>Minimal & Fast</h3>
          <p>Zero bloat, instant stream analysis, and clean format selection.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🔒</div>
          <h3>Privacy-First</h3>
          <p>No account creation, no password requirements, and zero persistent user tracking.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🎬</div>
          <h3>Real MP4 & MP3 Files</h3>
          <p>High-definition 1080p video with audio merged, and clean standalone MP3 audio extraction.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">📱</div>
          <h3>Universal Compatibility</h3>
          <p>Works directly in mobile browsers on iOS (iPhone/iPad) and Android without app downloads.</p>
        </div>
      </div>

      <h2>How YouPiper Helper Works</h2>
      <p>
        While YouPiper works 100% in your browser by default, desktop users with high-speed network connections can opt to install <a href="/helper">YouPiper Helper</a>. When running locally, YouPiper Helper handles media fetching directly on your machine, eliminating server queue wait times and saving files straight to your local Downloads folder.
      </p>

      <h2>Responsible Use & Respecting Creators</h2>
      <p>
        YouPiper is intended for personal archiving, educational research, and offline viewing of content you have permission to download. We encourage all users to respect creator copyright and observe platform terms of service.
      </p>

      <h2>Get in Touch</h2>
      <p>
        Have feedback, questions, or feature suggestions? Visit our <a href="/contact">Contact Page</a> or send us an email at <code>support@youpiper.com</code>.
      </p>
    </article>
  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 840px;
    margin: 0 auto;
    padding: 24px 24px 60px;
  }

  .breadcrumb-nav {
    margin-bottom: 24px;
    font-size: 14px;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-muted);
  }

  .breadcrumb-item a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb-item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb-item + .breadcrumb-item::before {
    content: "/";
    margin-right: 8px;
    color: var(--color-hairline);
  }

  .breadcrumb-item.active span {
    color: var(--color-ink);
    font-weight: 600;
  }

  .about-article {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body);
  }

  .lead-text {
    font-size: 17px;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .about-article h1 {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 12px;
    letter-spacing: -0.4px;
  }

  .about-article h2 {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 36px;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }

  .about-article p {
    margin-bottom: 16px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
    margin: 24px 0 32px;
  }

  .value-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-md);
    padding: 20px;
    box-shadow: var(--shadow-card);
  }

  .value-icon {
    font-size: 24px;
    margin-bottom: 8px;
  }

  .value-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .value-card p {
    font-size: 14px;
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .about-article code {
    background-color: var(--color-surface-soft);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--color-ink);
  }

  .about-article a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-article a:hover {
    color: var(--color-primary-active);
  }
</style>
