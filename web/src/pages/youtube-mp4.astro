---
import Layout from '../layouts/Layout.astro';
import Downloader from '../components/Downloader.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
---

<Layout
  title="Download YouTube to MP4 Video — YouPiper"
  description="Convert and download YouTube videos to MP4. Free, no sign-up, and compatible with every video player, phone, tablet, and smart TV."
>
  <div class="page-wrapper">
    <section class="downloader-section">
      <Downloader />
    </section>

    <AdPlaceholder slotLocation="seo-top" />

    <article class="seo-article">
      <h1>YouTube to MP4 Downloader</h1>
      <p>
        MP4 is the standard video container supported across every major operating system, video player, and smart TV. YouPiper downloads YouTube videos as clean MP4 files with the audio already merged in, so they play the moment you open them.
      </p>

      <h2>Universal Compatibility</h2>
      <p>
        Downloaded MP4 files play smoothly in QuickTime on macOS, Windows Media Player, VLC, iOS, and Android, and import cleanly into editors like Premiere Pro and Final Cut Pro.
      </p>

      <AdPlaceholder slotLocation="seo-mid" />

      <h2>How to Download MP4 Videos</h2>
      <ol>
        <li>Paste the YouTube video link above.</li>
        <li>Click <strong>Analyze</strong> to see the available qualities.</li>
        <li>Select <strong>1080p</strong> or <strong>720p</strong> MP4.</li>
        <li>Click <strong>Download</strong> and save your file.</li>
      </ol>
    </article>
  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .seo-article {
    max-width: 800px;
    margin: 48px auto;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body);
  }

  .seo-article h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .seo-article h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .seo-article p {
    margin-bottom: 16px;
  }

  .seo-article ul, .seo-article ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .seo-article li {
    margin-bottom: 8px;
  }
</style>
