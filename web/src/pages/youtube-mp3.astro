---
import Layout from '../layouts/Layout.astro';
import Downloader from '../components/Downloader.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
---

<Layout
  title="Convert YouTube to MP3 Audio — YouPiper"
  description="Extract high-quality MP3 audio from any YouTube video. Free, no sign-up, no length limits, and no software required."
>
  <div class="page-wrapper">
    <section class="downloader-section">
      <Downloader />
    </section>

    <AdPlaceholder slotLocation="seo-top" />

    <article class="seo-article">
      <h1>YouTube to MP3 Converter & Audio Extractor</h1>
      <p>
        YouPiper turns any YouTube video into an MP3 file. Whether you're saving podcasts, music, or lectures, paste the link, choose the Audio option, and get a clean MP3 back.
      </p>

      <h2>Why Convert With YouPiper?</h2>
      <ul>
        <li><strong>High-Quality Output:</strong> Audio is taken from the best stream YouTube provides before being converted to MP3.</li>
        <li><strong>No Length Limits:</strong> Convert long podcasts, DJ mixes, and full lectures — there's no 20-minute cap.</li>
        <li><strong>Plays Everywhere:</strong> MP3 works on every phone, car stereo, and music player without conversion.</li>
      </ul>

      <AdPlaceholder slotLocation="seo-mid" />

      <h2>Steps to Convert YouTube to MP3</h2>
      <ol>
        <li>Paste the YouTube video link into the URL field above.</li>
        <li>Click <strong>Analyze</strong> to load the available formats.</li>
        <li>Under <strong>Audio</strong>, choose the <strong>MP3</strong> row.</li>
        <li>Click <strong>Download</strong> and save your audio file.</li>
      </ol>
    </article>
  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .seo-article {
    max-width: 800px;
    margin: 48px auto;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body);
  }

  .seo-article h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .seo-article h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .seo-article p {
    margin-bottom: 16px;
  }

  .seo-article ul, .seo-article ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .seo-article li {
    margin-bottom: 8px;
  }
</style>
