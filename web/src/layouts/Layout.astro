---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "YouPiper — Free YouTube Video Downloader & MP3 Converter",
  description = "Fast, free YouTube video downloader. Save 1080p, 720p, 480p, and 360p MP4 video or MP3 audio. Works right in your browser, and even faster with YouPiper Helper.",
  canonicalUrl = Astro.url.href,
  ogImage = "https://youpiper.com/og-image.png"
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "YouPiper",
  "url": "https://youpiper.com",
  "operatingSystem": "macOS, Windows, Linux",
  "applicationCategory": "MultimediaApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <!-- Header / Navigation -->
  <header class="top-nav">
    <div class="nav-container">
      <a href="/" class="brand-logo">
        <svg viewBox="0 0 32 32" class="brand-icon">
          <path d="M16 1C7.716 1 1 7.716 1 16c0 8.284 6.716 15 15 15 8.284 0 15-6.716 15-15C31 7.716 24.284 1 16 1zm-3.5 21.5v-13l10 6.5-10 6.5z"/>
        </svg>
        <span class="brand-name">YouPiper</span>
      </a>

      <nav class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/youtube-video-downloader" class="nav-link">Video Downloader</a>
        <a href="/youtube-mp3" class="nav-link">MP3 Downloader</a>
        <a href="/youtube-mp4" class="nav-link">MP4 Converter</a>
        <a href="/helper" class="nav-link nav-link-helper">Get Helper</a>
      </nav>
    </div>
  </header>

  <!-- Page Main Content -->
  <main class="page-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer-light">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4 class="footer-title">YouPiper</h4>
          <p class="footer-text">
            A minimal, fast downloader for high quality video and audio — in your browser, or straight to your computer with YouPiper Helper.
          </p>
        </div>
        <div class="footer-col">
          <h4 class="footer-title">Tools</h4>
          <ul class="footer-links">
            <li><a href="/youtube-video-downloader">YouTube Video Downloader</a></li>
            <li><a href="/youtube-mp3">YouTube to MP3 Converter</a></li>
            <li><a href="/youtube-mp4">YouTube to MP4 Downloader</a></li>
            <li><a href="/helper">Get YouPiper Helper</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-title">Legal & Usage</h4>
          <p class="footer-legal">
            YouPiper is intended for personal backup and educational use. Users are responsible for complying with content owners' permissions and applicable copyright laws.
          </p>
        </div>
      </div>

      <div class="legal-band">
        <span>© {new Date().getFullYear()} YouPiper</span>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* Airbnb Design Tokens */
  :root {
    --color-primary: #ff385c;
    --color-primary-active: #e00b41;
    --color-primary-disabled: #ffd1da;
    --color-ink: #222222;
    --color-body: #3f3f3f;
    --color-muted: #6a6a6a;
    --color-hairline: #dddddd;
    --color-hairline-soft: #ebebeb;
    --color-canvas: #ffffff;
    --color-surface-soft: #f7f7f7;
    --color-surface-strong: #f2f2f2;
    --color-on-primary: #ffffff;

    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

    --rounded-sm: 8px;
    --rounded-md: 14px;
    --rounded-lg: 20px;
    --rounded-full: 9999px;

    --shadow-card: rgba(0, 0, 0, 0.02) 0 0 0 1px, rgba(0, 0, 0, 0.04) 0 2px 6px 0, rgba(0, 0, 0, 0.1) 0 4px 8px 0;
    --shadow-hover: rgba(0, 0, 0, 0.04) 0 0 0 1px, rgba(0, 0, 0, 0.08) 0 4px 12px 0, rgba(0, 0, 0, 0.15) 0 8px 16px 0;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-family);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Header Navigation */
  .top-nav {
    height: 80px;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1140px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.5px;
  }

  .brand-icon {
    width: 32px;
    height: 32px;
    fill: var(--color-primary);
  }

  .nav-links {
    display: flex;
    gap: 28px;
  }

  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  /* Helper is a desktop companion, so this link intentionally rides the
     nav and disappears with it on mobile, where it would be a dead end. */
  .nav-link-helper {
    color: var(--color-ink);
    font-weight: 600;
    padding: 7px 14px;
    margin: -7px 0;
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-full);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link-helper:hover {
    border-color: var(--color-ink);
    background-color: var(--color-surface-soft);
  }

  .nav-link-helper:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .page-content {
    min-height: calc(100vh - 300px);
  }

  /* Footer */
  .footer-light {
    border-top: 1px solid var(--color-hairline);
    padding: 64px 24px 32px;
    background-color: var(--color-canvas);
    margin-top: 64px;
  }

  .footer-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .nav-links {
      display: none;
    }
  }

  .footer-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .footer-text, .footer-legal {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 14px;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-ink);
  }

  .legal-band {
    border-top: 1px solid var(--color-hairline-soft);
    padding-top: 24px;
    font-size: 13px;
    color: var(--color-muted);
    text-align: center;
  }
</style>
