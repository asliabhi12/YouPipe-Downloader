---
interface Props {
  slotLocation?: string;
  className?: string;
}

const { slotLocation = "content-banner", className = "" } = Astro.props;
---

<div class={`ad-placeholder-wrapper ${className}`} data-slot={slotLocation}>
  <div class="ad-label">ADVERTISEMENT</div>
  <div class="ad-box">
    <span class="ad-text">Ad Placement Area</span>
  </div>
</div>

<style>
  .ad-placeholder-wrapper {
    margin: 32px auto;
    width: 100%;
    max-width: 970px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .ad-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--color-ink-muted, #8c8c8c);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .ad-box {
    width: 100%;
    max-width: 728px;
    min-height: 90px;
    background-color: var(--color-surface, #f9f9f9);
    border: 1px dashed var(--color-hairline, #e5e5e5);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    transition: min-height 0.2s ease;
  }

  .ad-text {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-ink-muted, #8c8c8c);
    text-align: center;
  }

  @media (max-width: 768px) {
    .ad-placeholder-wrapper {
      margin: 24px auto;
      padding: 0 16px;
    }

    .ad-box {
      max-width: 100%;
      min-height: 100px;
    }
  }

  @media (max-width: 480px) {
    .ad-box {
      min-height: 100px;
    }
  }
</style>
