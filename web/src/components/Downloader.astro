---
import AgentStatus from './AgentStatus.astro';
import VideoInfo from './VideoInfo.astro';
import FormatList from './FormatList.astro';
import DownloadProgress from './DownloadProgress.astro';

interface Props {
  title?: string;
  tagline?: string;
  headingLevel?: 'h1' | 'h2' | 'none';
}

const {
  title = "YouTube Video Download",
  tagline = "Download YouTube videos online in MP4, HD and 4K quality with a fast, simple and easy-to-use video downloader.",
  headingLevel = "h1"
} = Astro.props;
---

<div class="downloader-island">
  {headingLevel !== 'none' && (
    <div class="downloader-hero">
      {headingLevel === 'h1' ? (
        <h1 class="hero-brand">{title}</h1>
      ) : (
        <h2 class="hero-brand">{title}</h2>
      )}
      <p class="hero-tagline">{tagline}</p>
    </div>
  )}

  <!-- Search Input Bar -->
  <form id="downloader-url-form" class="search-bar-pill">
    <div class="search-field">
      <label for="url-input" class="search-label">Paste video URL</label>
      <input
        type="url"
        id="url-input"
        class="search-input"
        placeholder="https://www.youtube.com/watch?v=..."
        required
        autocomplete="off"
      />
    </div>
    <button type="submit" id="btn-analyze" class="search-orb" title="Analyze Video">
      <span class="btn-text">Analyze video</span>
    </button>
  </form>

  <!-- Helper availability. Sits here, outside the results block, so it is
       readable on page load rather than only after an analysis succeeds. -->
  <AgentStatus />

  <!-- Notice (something worth knowing, e.g. a fallback) vs. error (the thing
       the user asked for did not happen). They look different on purpose. -->
  <div id="downloader-notice" class="notice-banner hidden"></div>
  <div id="downloader-error" class="error-banner hidden"></div>

  <!-- Analysis Results Section -->
  <div id="analysis-results" class="analysis-container hidden">
    <VideoInfo />
    <FormatList />
  </div>

  <!-- Download Progress Section -->
  <DownloadProgress />
</div>

<script>
  import {
    analyze,
    download,
    getStatus,
    getFile,
    helperStore,
    friendlyJobError,
    MESSAGE_HELPER_CONNECTION_LOST,
    QUALITY_SHORT_LABELS,
    getResolutionText
  } from '../lib/agent';

  let currentUrl = '';
  let activeJobId = '';
  let activeBackend: 'local' | 'online' = 'online';
  let pollInterval: any = null;
  let isStartingJob = false;
  let activeDownloadingBtn: HTMLButtonElement | null = null;
  let activeBtnOriginalText = '';
  // Which backend the currently rendered format rows are labelled for. Kept so
  // the labels can follow a Helper that starts or stops after an analysis.
  let renderedBackend: 'local' | 'online' = 'online';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('downloader-url-form');
    const input = document.getElementById('url-input') as HTMLInputElement;
    const btnAnalyze = document.getElementById('btn-analyze');
    const errorBanner = document.getElementById('downloader-error');
    const noticeBanner = document.getElementById('downloader-notice');
    const analysisContainer = document.getElementById('analysis-results');
    const progressContainer = document.getElementById('progress-container');

    const statusPill = document.getElementById('job-status-pill');
    const qualityTag = document.getElementById('job-quality-tag');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressPctText = document.getElementById('progress-pct-text');
    const progressMetricsText = document.getElementById('progress-metrics-text');
    const completedBanner = document.getElementById('completed-banner');
    const completedMessageText = document.getElementById('completed-message-text');
    const btnSaveFile = document.getElementById('btn-save-file');

    if (!form || !input || !btnAnalyze || !errorBanner || !noticeBanner || !analysisContainer || !progressContainer) return;

    function showError(msg: string) {
      errorBanner.textContent = msg;
      errorBanner.classList.remove('hidden');
    }

    function hideError() {
      errorBanner.classList.add('hidden');
    }

    function showNotice(msg: string) {
      noticeBanner.textContent = msg;
      noticeBanner.classList.remove('hidden');
    }

    function hideNotice() {
      noticeBanner.classList.add('hidden');
    }

    /** The subtle "where will this download come from" tag on each row. */
    function backendHintMarkup(isHelper: boolean): string {
      return isHelper
        ? '<span class="backend-hint local">⚡ Local</span>'
        : '<span class="backend-hint online">Online</span>';
    }

    function videoRowMarkup(quality: string, height?: number, isHelper: boolean = false): string {
      const shortLabel = QUALITY_SHORT_LABELS[quality] || quality;
      const resolution = getResolutionText(height, quality);

      return `
        <div class="format-card" data-quality="${quality}">
          <div class="format-main-info">
            <span class="quality-badge">${quality}</span>
            <span class="quality-label">${shortLabel}</span>
            ${resolution ? `<span class="resolution-tag">${resolution}</span>` : ''}
            <span class="container-badge">MP4</span>
            ${backendHintMarkup(isHelper)}
          </div>
          <button type="button" class="btn-download-format" data-quality="${quality}">
            <svg class="dl-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            <span class="btn-text-content">Download</span>
          </button>
        </div>`;
    }

    function audioRowMarkup(isHelper: boolean = false): string {
      return `
        <div class="format-card audio-card" data-quality="audio">
          <div class="format-main-info">
            <span class="audio-emoji">🎵</span>
            <span class="quality-badge">MP3</span>
            <span class="quality-label">Audio only</span>
            <span class="container-badge">MP3</span>
            ${backendHintMarkup(isHelper)}
          </div>
          <button type="button" class="btn-download-format" data-quality="audio">
            <svg class="dl-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            <span class="btn-text-content">Download</span>
          </button>
        </div>`;
    }

    // Keep the row tags honest when the Helper starts or stops while results are
    // on screen. Only genuine transitions relabel: a fallback may have rendered
    // "Online" rows while the Helper is still up, and re-asserting "Local" over
    // them would contradict where the request actually went. Only the tags are
    // rewritten — re-rendering the rows would wipe the state of a download
    // button that is mid-job.
    let lastHelperState: string | null = null;
    helperStore.subscribe((snapshot) => {
      if (snapshot.state === 'checking') return;
      const previous = lastHelperState;
      lastHelperState = snapshot.state;
      if (previous === null || previous === snapshot.state) return;

      const isHelper = snapshot.state === 'available';
      renderedBackend = isHelper ? 'local' : 'online';
      analysisContainer.querySelectorAll('.backend-hint').forEach((el) => {
        el.className = `backend-hint ${isHelper ? 'local' : 'online'}`;
        el.textContent = isHelper ? '⚡ Local' : 'Online';
      });
    });

    function safeErrorMessage(err: any, fallback: string): string {
      if (err && typeof err === 'object' && (err.name === 'BackendError' || err.code) && typeof err.message === 'string') {
        return err.message;
      }
      return fallback;
    }

    // Form submission: Analyze
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      hideNotice();
      currentUrl = input.value.trim();
      if (!currentUrl) return;

      btnAnalyze.setAttribute('disabled', 'true');
      btnAnalyze.innerHTML = '<span class="spinner"></span><span class="btn-text">Analyzing…</span>';

      try {
        const meta = await analyze(currentUrl);
        renderMetadata(meta);
        // analyze() may have quietly covered for the Helper. Say so rather than
        // letting the row tags flip to "Online" with no explanation.
        if (meta.notice) showNotice(meta.notice);
      } catch (err: any) {
        // The sentence on the error is already written for a person; the code
        // and backend detail stay in the console.
        console.error('[youpiper] analyze failed:', err);
        showError(safeErrorMessage(err, 'We could not analyze this video. Please check the link and try again.'));
      } finally {
        btnAnalyze.removeAttribute('disabled');
        btnAnalyze.innerHTML = '<span class="btn-text">Analyze video</span>';
      }
    });

    // Single delegated click listener on analysisContainer
    analysisContainer.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('.btn-download-format') as HTMLButtonElement;
      if (!btn) return;

      const quality = btn.getAttribute('data-quality') || '1080p';
      if (isStartingJob) return;

      startJob(currentUrl, quality, btn);
    });

    function renderMetadata(meta: any) {
      analysisContainer.classList.remove('hidden');

      const thumb = analysisContainer.querySelector('.thumbnail-img') as HTMLImageElement;
      const title = analysisContainer.querySelector('.video-title');
      const uploader = analysisContainer.querySelector('.uploader-name strong');
      const duration = analysisContainer.querySelector('.duration-badge');

      if (thumb) thumb.src = meta.thumbnail || '/thumbnail-fallback.svg';
      if (title) title.textContent = meta.title || 'Untitled Video';
      if (uploader) uploader.textContent = meta.uploader || 'Unknown Channel';

      if (duration) {
        const mins = Math.floor((meta.duration || 0) / 60);
        const secs = Math.floor((meta.duration || 0) % 60);
        duration.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
      }

      // Label the rows for the backend that just answered, rather than asking
      // about Helper availability a second time.
      const helperReady = meta.backend === 'local';
      activeBackend = helperReady ? 'local' : 'online';
      renderedBackend = activeBackend;

      const videoContainer = analysisContainer.querySelector('#video-format-rows');
      const audioContainer = analysisContainer.querySelector('#audio-format-rows');

      const formats = Array.isArray(meta.formats) ? meta.formats : [];
      const videoFormats = formats.filter((f: any) => f.quality !== 'audio');
      const hasAudio = formats.some((f: any) => f.quality === 'audio');

      if (videoContainer) {
        videoContainer.innerHTML = videoFormats
          .map((f: any) => videoRowMarkup(f.quality, f.height, helperReady))
          .join('');
      }

      if (audioContainer) {
        audioContainer.innerHTML = hasAudio ? audioRowMarkup(helperReady) : '';
      }

      analysisContainer.scrollIntoView({ behavior: 'smooth' });
    }

    async function startJob(url: string, quality: string, btnElement?: HTMLButtonElement) {
      if (isStartingJob) return;
      isStartingJob = true;
      hideError();

      if (activeDownloadingBtn) {
        activeDownloadingBtn.disabled = false;
        const oldLabel = activeDownloadingBtn.querySelector('.btn-text-content');
        if (oldLabel && activeBtnOriginalText) oldLabel.textContent = activeBtnOriginalText;
      }

      activeDownloadingBtn = btnElement || null;
      if (btnElement) {
        btnElement.disabled = true;
        const labelEl = btnElement.querySelector('.btn-text-content');
        if (labelEl) {
          activeBtnOriginalText = labelEl.textContent || '';
          labelEl.textContent = `Downloading ${quality === 'audio' ? 'MP3' : quality}…`;
        }
      }

      try {
        const expectedBackend = renderedBackend;
        const res = await download(url, quality);
        activeJobId = res.job_id;
        activeBackend = res.backend;

        // The row promised a local download and it ended up online. Say so
        // instead of silently changing where the file comes from.
        if (expectedBackend === 'local' && res.backend === 'online') {
          showNotice('YouPiper Helper could not take this download, so we used the online downloader instead.');
        }

        if (qualityTag) qualityTag.textContent = quality === 'audio' ? 'mp3' : quality;
        progressContainer.classList.remove('hidden');
        if (completedBanner) completedBanner.classList.add('hidden');
        if (btnSaveFile) {
          if (activeBackend === 'local') {
            btnSaveFile.classList.add('hidden');
          } else {
            btnSaveFile.classList.remove('hidden');
            btnSaveFile.removeAttribute('disabled');
            btnSaveFile.textContent = 'Save File';
          }
        }

        startPolling(activeJobId, activeBackend);
      } catch (err: any) {
        console.error('[youpiper] starting the download failed:', err);
        showError(safeErrorMessage(err, 'We could not start that download. Please try again.'));
        if (btnElement) {
          btnElement.disabled = false;
          const labelEl = btnElement.querySelector('.btn-text-content');
          if (labelEl && activeBtnOriginalText) labelEl.textContent = activeBtnOriginalText;
        }
      } finally {
        isStartingJob = false;
      }
    }

    function startPolling(jobId: string, backend: 'local' | 'online') {
      if (pollInterval) clearInterval(pollInterval);

      // A single failed poll is a hiccup; several in a row on a local job means
      // the Helper went away mid-download. That has to be reported — the file is
      // very likely incomplete, and leaving the bar spinning would imply
      // otherwise.
      let consecutiveFailures = 0;
      const maxConsecutiveFailures = 4;

      pollInterval = setInterval(async () => {
        try {
          const job = await getStatus(jobId, backend);
          consecutiveFailures = 0;
          updateProgressUI(job);

          if (['completed', 'failed', 'cancelled'].includes(job.status)) {
            clearInterval(pollInterval);
            pollInterval = null;
          }
        } catch (err) {
          consecutiveFailures++;
          console.error(
            `[youpiper] progress poll failed (${consecutiveFailures}/${maxConsecutiveFailures}):`,
            err
          );
          if (consecutiveFailures < maxConsecutiveFailures) return;

          clearInterval(pollInterval);
          pollInterval = null;

          if (backend === 'local') {
            void helperStore.refresh();
            showError(MESSAGE_HELPER_CONNECTION_LOST);
          } else {
            showError('We lost track of that download. Please try again.');
          }

          if (statusPill) {
            statusPill.className = 'status-pill failed';
            statusPill.textContent = 'failed';
          }
          if (progressMetricsText) progressMetricsText.textContent = 'Connection lost';
          if (progressBarFill) progressBarFill.style.backgroundColor = '#cf1322';
          if (activeDownloadingBtn) {
            activeDownloadingBtn.disabled = false;
            const labelEl = activeDownloadingBtn.querySelector('.btn-text-content');
            if (labelEl && activeBtnOriginalText) labelEl.textContent = activeBtnOriginalText;
          }
        }
      }, 750);
    }

    function updateProgressUI(job: any) {
      if (!statusPill || !progressBarFill || !progressPctText || !progressMetricsText) return;

      statusPill.className = `status-pill ${job.status}`;
      statusPill.textContent = job.status;

      const pct = Math.round(job.progress || 0);
      progressBarFill.style.width = `${pct}%`;
      progressPctText.textContent = `${pct}%`;

      if (job.status === 'downloading') {
        const via = job.backend === 'local' ? ' • via YouPiper Helper' : '';
        if (typeof job.speed === 'number' && job.eta != null && job.speed > 0) {
          const speedMB = (job.speed / (1024 * 1024)).toFixed(1);
          progressMetricsText.textContent = `${speedMB} MB/s • ${job.eta}s remaining${via}`;
        } else {
          progressMetricsText.textContent = `Downloading… ${pct}%${via}`;
        }
      } else if (job.status === 'processing') {
        progressMetricsText.textContent = 'Merging video & audio…';
      } else if (job.status === 'completed') {
        progressMetricsText.textContent = job.backend === 'local' ? 'Saved to your Downloads folder' : 'Finished!';
        progressBarFill.style.backgroundColor = '#389e0d';
        if (completedBanner) {
          completedBanner.classList.remove('hidden');
          if (completedMessageText) {
            completedMessageText.textContent = job.backend === 'local'
              ? '✓ Download complete. Saved to your Downloads folder.'
              : '✓ Download complete. Your file is ready.';
          }
        }
        if (activeDownloadingBtn) {
          const labelEl = activeDownloadingBtn.querySelector('.btn-text-content');
          if (labelEl) {
            labelEl.textContent = job.backend === 'local' ? '✓ Downloaded' : '✓ Ready';
          }
        }
      } else if (job.status === 'failed') {
        // job.error is "<code>: <detail>" — the code is mapped for the user and
        // the whole thing kept in the console.
        console.error(`[youpiper] job ${job.job_id} failed on the ${job.backend} backend:`, job.error);
        const message = friendlyJobError(job.error, job.backend);
        progressMetricsText.textContent = message;
        progressBarFill.style.backgroundColor = '#cf1322';
        showError(
          job.backend === 'local'
            ? `${message} You can also try again without YouPiper Helper by quitting it.`
            : message
        );
        if (activeDownloadingBtn) {
          activeDownloadingBtn.disabled = false;
          const labelEl = activeDownloadingBtn.querySelector('.btn-text-content');
          if (labelEl && activeBtnOriginalText) labelEl.textContent = activeBtnOriginalText;
        }
      } else if (job.status === 'cancelled') {
        progressMetricsText.textContent = 'Cancelled by user';
        progressBarFill.style.backgroundColor = '#cf1322';
        if (activeDownloadingBtn) {
          activeDownloadingBtn.disabled = false;
          const labelEl = activeDownloadingBtn.querySelector('.btn-text-content');
          if (labelEl && activeBtnOriginalText) labelEl.textContent = activeBtnOriginalText;
        }
      }
    }

    // Save File button for online mode
    if (btnSaveFile) {
      btnSaveFile.addEventListener('click', async () => {
        if (!activeJobId) return;
        btnSaveFile.setAttribute('disabled', 'true');
        btnSaveFile.textContent = 'Saving...';
        const ok = await getFile(activeJobId);
        if (ok) {
          btnSaveFile.textContent = 'Saved';
        } else {
          btnSaveFile.removeAttribute('disabled');
          btnSaveFile.textContent = 'Save File';
          showError('Could not save the file. Please try analyzing and downloading again.');
        }
      });
    }
  });
</script>

<style>
  .downloader-island {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .downloader-hero {
    text-align: center;
    margin-bottom: 32px;
  }

  .hero-brand {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }

  .hero-tagline {
    font-size: 18px;
    color: var(--color-muted);
  }

  .search-bar-pill {
    width: 100%;
    height: 64px;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--rounded-full);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    padding: 8px 8px 8px 24px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .search-bar-pill:focus-within,
  .search-bar-pill:hover {
    box-shadow: var(--shadow-hover);
    border-color: var(--color-ink);
  }

  .search-field {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .search-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .search-input {
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-family);
    font-size: 16px;
    color: var(--color-ink);
    width: 100%;
  }

  .search-input::placeholder {
    color: var(--color-muted);
  }

  .search-orb {
    height: 48px;
    padding: 0 24px;
    background-color: var(--color-primary);
    border-radius: var(--rounded-full);
    border: none;
    color: var(--color-on-primary);
    font-family: var(--font-family);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .search-orb:hover {
    background-color: var(--color-primary-active);
  }

  .error-banner {
    width: 100%;
    padding: 12px 20px;
    background-color: #fff1f0;
    border: 1px solid #ffa39e;
    color: #cf1322;
    font-size: 14px;
    border-radius: var(--rounded-sm);
    margin-bottom: 24px;
    text-align: center;
  }

  /* A notice is "here is what happened", not "something broke" — so it is
     informational blue rather than the error red above. */
  .notice-banner {
    width: 100%;
    padding: 12px 20px;
    margin-top: 12px;
    background-color: #f0f7ff;
    border: 1px solid #bcdcff;
    color: #0b4a86;
    font-size: 14px;
    border-radius: var(--rounded-sm);
    text-align: center;
  }

  /* Which backend a row will use. Subtle by design: the system has already
     chosen, and this is a note, not a control. */
  :global(.backend-hint) {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 6px;
  }

  :global(.backend-hint.local) {
    color: #237804;
    background-color: #f6ffed;
    border: 1px solid #d9f7be;
  }

  :global(.backend-hint.online) {
    color: var(--color-muted);
    background-color: var(--color-surface-soft);
    border: 1px solid var(--color-hairline-soft);
  }

  .analysis-container {
    width: 100%;
    margin-top: 16px;
  }

  /* Format row and download button styles live in FormatList.astro as
     :global() rules — the rows are injected via innerHTML, so Astro's
     scoped styles would never match them. Don't redeclare them here. */

  .hidden {
    display: none !important;
  }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top: 2px solid #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>
