---
// Helper availability indicator.
//
// It reads the shared store in lib/agent and never performs its own health
// check, so what it shows and where requests actually go cannot disagree.
//
// This is meant to sit under the URL field and be readable at a glance before
// the user does anything. An unavailable Helper is the normal state for most
// visitors — the site works fine without it — so it is styled as information,
// not as an error.
---

<div id="helper-indicator" class="helper-indicator" data-state="checking" aria-live="polite">
  <span class="helper-dot" aria-hidden="true"></span>
  <span class="helper-text">
    <span class="helper-title" id="helper-indicator-title">Checking for YouPiper Helper…</span>
    <span class="helper-detail" id="helper-indicator-detail">One moment.</span>
  </span>
  <div class="helper-actions">
    <button type="button" class="helper-toggle-btn btn-off" id="helper-btn-off" hidden>Turn Off</button>
    <button type="button" class="helper-toggle-btn btn-on" id="helper-btn-on" hidden>Turn On</button>
    <a href="/helper" class="helper-cta" id="helper-indicator-cta">Get Helper</a>
  </div>
</div>

<script>
  import { helperStore, HELPER_COPY, turnOffHelper, turnOnHelper, BackendError } from '../lib/agent';

  const root = document.getElementById('helper-indicator');
  const titleEl = document.getElementById('helper-indicator-title');
  const detailEl = document.getElementById('helper-indicator-detail');
  const ctaEl = document.getElementById('helper-indicator-cta');
  const btnOff = document.getElementById('helper-btn-off') as HTMLButtonElement | null;
  const btnOn = document.getElementById('helper-btn-on') as HTMLButtonElement | null;

  if (root && titleEl && detailEl && ctaEl && btnOff && btnOn) {
    helperStore.subscribe((snapshot) => {
      const copy = HELPER_COPY[snapshot.state];
      root.dataset.state = snapshot.state;

      if (snapshot.state === 'available') {
        titleEl.textContent = 'YouPiper Helper';
        detailEl.textContent = '● Running';
        btnOff.hidden = false;
        btnOn.hidden = true;
        ctaEl.hidden = true;
      } else if (snapshot.state === 'checking') {
        titleEl.textContent = copy.title;
        detailEl.textContent = copy.detail;
        btnOff.hidden = true;
        btnOn.hidden = true;
        ctaEl.hidden = true;
      } else {
        titleEl.textContent = 'YouPiper Helper';
        detailEl.textContent = '○ Off';
        btnOff.hidden = true;
        btnOn.hidden = false;
        ctaEl.hidden = false;
      }
    });

    btnOff.addEventListener('click', async () => {
      try {
        btnOff.disabled = true;
        await turnOffHelper(false);
      } catch (err) {
        if (err instanceof BackendError && err.code === 'active_job') {
          if (confirm('An active download is currently in progress. Stop YouPiper Helper anyway?')) {
            await turnOffHelper(true);
          }
        } else {
          console.error('Failed to turn off Helper:', err);
        }
      } finally {
        btnOff.disabled = false;
      }
    });

    btnOn.addEventListener('click', () => {
      turnOnHelper();
    });

    helperStore.start();

    // Coming back to the tab is the moment a user is most likely to have just
    // started the Helper, so check then instead of polling harder for it.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        helperStore.start();
      } else {
        helperStore.stop();
      }
    });
    window.addEventListener('focus', () => void helperStore.refresh());
  }
</script>

<style>
  .helper-indicator {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    margin-top: 12px;
    font-size: 13px;
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--rounded-full);
    background-color: var(--color-surface-soft);
    color: var(--color-muted);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .helper-text {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .helper-title {
    font-weight: 600;
    color: var(--color-body);
    white-space: nowrap;
  }

  .helper-detail {
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Status is carried by a dot rather than by colouring the whole row, which
     keeps the unavailable state from reading as a warning. */
  .helper-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: transparent;
    border: 1.5px solid var(--color-hairline);
  }

  .helper-indicator[data-state='available'] {
    background-color: #f6ffed;
    border-color: #d9f7be;
  }

  .helper-indicator[data-state='available'] .helper-dot {
    background-color: #52c41a;
    border-color: #52c41a;
    box-shadow: 0 0 6px rgba(82, 196, 26, 0.5);
  }

  .helper-indicator[data-state='available'] .helper-title {
    color: #135200;
  }

  .helper-indicator[data-state='available'] .helper-detail {
    color: #237804;
  }

  .helper-indicator[data-state='checking'] .helper-dot {
    animation: helper-pulse 1.2s ease-in-out infinite;
  }

  @keyframes helper-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .helper-indicator[data-state='checking'] .helper-dot {
      animation: none;
    }
  }

  .helper-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .helper-toggle-btn {
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 9999px;
    cursor: pointer;
    border: 1px solid var(--color-hairline, #d9d9d9);
    background-color: var(--color-surface, #ffffff);
    color: var(--color-body, #262626);
    transition: all 0.15s ease;
  }

  .helper-toggle-btn.btn-off {
    background-color: #fff1f0;
    border-color: #ffa39e;
    color: #cf1322;
  }

  .helper-toggle-btn.btn-off:hover {
    background-color: #ffccc7;
  }

  .helper-toggle-btn.btn-on {
    background-color: #f6ffed;
    border-color: #b7eb8f;
    color: #389e0d;
  }

  .helper-toggle-btn.btn-on:hover {
    background-color: #d9f7be;
  }

  .helper-toggle-btn[hidden] {
    display: none;
  }

  .helper-cta {
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .helper-cta:hover {
    color: var(--color-primary);
  }

  .helper-cta[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .helper-indicator {
      border-radius: var(--rounded-md);
      align-items: flex-start;
    }

    .helper-text {
      flex-direction: column;
      gap: 2px;
    }

    .helper-title,
    .helper-detail {
      white-space: normal;
    }
  }
</style>
