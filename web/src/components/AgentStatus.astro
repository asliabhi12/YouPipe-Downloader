---
---

<div id="agent-status-container" class="helper-status-wrapper">
  <!-- Helper Ready Banner -->
  <div id="helper-ready-card" class="helper-card helper-ready hidden">
    <div class="status-left">
      <span class="status-dot green"></span>
      <span class="status-title">YouPiper Helper ready</span>
    </div>
    <span class="status-subtitle">Downloads go directly to your computer.</span>
  </div>

  <!-- Helper Promo Banner (when helper unavailable) -->
  <div id="helper-promo-card" class="helper-card helper-promo hidden">
    <div class="promo-left">
      <div class="promo-title">⚡ Faster downloads with YouPiper Helper</div>
      <div class="promo-subtitle">Download directly to your computer. No server queue.</div>
    </div>
    <a href="/helper" class="btn-install-helper">Install Helper</a>
  </div>
</div>

<script>
  import { checkAgent } from '../lib/agent';

  async function updateStatus() {
    const readyCard = document.getElementById('helper-ready-card');
    const promoCard = document.getElementById('helper-promo-card');

    if (!readyCard || !promoCard) return;

    const health = await checkAgent();

    if (health && (health.status === 'ok' || health.status === 'degraded')) {
      readyCard.classList.remove('hidden');
      promoCard.classList.add('hidden');
    } else {
      readyCard.classList.add('hidden');
      promoCard.classList.remove('hidden');
    }
  }

  updateStatus();
  setInterval(updateStatus, 5000);
</script>

<style>
  .helper-status-wrapper {
    width: 100%;
    margin: 16px 0;
  }

  .helper-card {
    border-radius: var(--rounded-md);
    padding: 12px 18px;
    transition: all 0.2s ease;
  }

  .helper-card.helper-ready {
    background-color: #f6ffed;
    border: 1px solid #b7eb8f;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .helper-card.helper-ready {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .status-dot.green {
    background-color: #52c41a;
    box-shadow: 0 0 6px rgba(82, 196, 26, 0.5);
  }

  .status-title {
    font-size: 14px;
    font-weight: 700;
    color: #135200;
  }

  .status-subtitle {
    font-size: 13px;
    color: #237804;
  }

  .helper-card.helper-promo {
    background-color: #f9f9fb;
    border: 1px solid var(--color-hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .helper-card.helper-promo {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }

  .promo-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-ink);
  }

  .promo-subtitle {
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 2px;
  }

  .btn-install-helper {
    background-color: var(--color-ink);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: var(--rounded-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .btn-install-helper:hover {
    background-color: #000000;
  }

  .hidden {
    display: none !important;
  }
</style>
