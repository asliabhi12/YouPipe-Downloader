# Binaries and executables
# Anchored: a bare "agent" would also ignore local/cmd/agent/, which is source.
/agent
/local/agent
*.exe
!web/public/downloads/*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binaries and coverage reports
*.test
*.out
coverage.txt
coverage.out

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE, Tooling and Editor files
.idea/
.vscode/
.claude/
.cursor/
*.swp
*.swo

# Node & Frontend dependencies & builds
node_modules/
dist/
.astro/

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Environment files & logs
.env
.env.*
*.log

# Local build artifacts & temporary downloads
downloads/
test_downloads/
scratch/
/server/tmp/

# Bundled third-party binaries fetched by packaging/fetch-vendor.sh.
# These are large, redistributable upstream releases; they are reproduced from
# SHA256SUMS.lock rather than committed. Build outputs land in dist/ (above).
/local/packaging/vendor/
!/local/packaging/vendor/SHA256SUMS.lock
